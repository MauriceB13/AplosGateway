# AplosGateway customer deployment template
#
# Copy this file to a customer-specific file such as:
#   .env.customer-name
#
# Never commit the customer-specific file.

# ------------------------------------------------------------
# Gateway
# ------------------------------------------------------------

Gateway__Name=AplosGateway

# Host port exposed by Docker Compose.
GATEWAY_PORT=8080

# ------------------------------------------------------------
# Gateway security
# Required. Generate a unique value for every customer.
# ------------------------------------------------------------

Security__ApiKey=

# ------------------------------------------------------------
# Aplos
# ------------------------------------------------------------

Aplos__BaseUrl=https://app.aplos.com/hermes/api/v1
Aplos__ClientId=
Aplos__PrivateKey=

# Safety default. Enable only after the deployment and mapping
# have been verified for this customer.
Aplos__AllowTransactionPosting=false

# ------------------------------------------------------------
# Virtuous
# ------------------------------------------------------------

Virtuous__OrganizationId=

# ------------------------------------------------------------
# Aplos transaction mapping
# ------------------------------------------------------------

TransactionMapping__DepositAccountNumber=
TransactionMapping__IncomeAccountNumber=
TransactionMapping__FundId=

# ------------------------------------------------------------
# Durable processing ledger
# PostgreSQL connection string for this customer's deployment.
# ------------------------------------------------------------

ProcessingLedger__ConnectionString=

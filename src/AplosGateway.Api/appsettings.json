{
  "Gateway": {
    "Name": "AplosGateway",
    "Version": "0.1.0"
  },
  "Security": {
    "ApiKey": ""
  },
  "Aplos": {
    "BaseUrl": "https://app.aplos.com/hermes/api/v1",
    "ClientId": "",
    "PrivateKey": "",
    "AllowTransactionPosting": false
  },

  "Idempotency": {
  "ConnectionString": "Data Source=Data/aplosgateway.db"
},

"Virtuous": {
  "OrganizationId": 7472
},

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}